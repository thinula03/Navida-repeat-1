<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Project Approval System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="shell topbar__inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand__mark">PAS</span>
                <span class="brand__text">
                    <strong>Project Approval System</strong>
                    <small>Research governance suite</small>
                </span>
            </a>
            <nav aria-label="Primary navigation">
                <a href="#map">Map</a>
                <a href="#dashboard">Dashboard</a>
                <a href="#supervisors">Supervisors</a>
                <a href="#proposal">Proposal</a>
                <a href="#qa">QA Evidence</a>
            </nav>
            <div class="topbar__status" aria-label="System status">
                <span></span>
                Production-style QA Build
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="shell">
            Project Approval System - PUSL2020 CILE implementation
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
